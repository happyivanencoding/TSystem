      "url": "https://data-api.ecb.europa.eu/service/data/ICP/M.U2.N.000000.4.ANR",
      "parameters": {
        "format": "csvdata",
        "includeHistory": "true"
      },
      "available_column": "VALID_FROM",
      "unit": "percent"
    },
    {
      "provider": "ecb",
      "enabled": true,
      "series_id": "ECB:FM.D.U2.EUR.4F.KR.MRR_FR.LEV",
