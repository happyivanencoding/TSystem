      "parameters": {
        "format": "csvdata",
        "includeHistory": "true"
      },
      "available_column": "VALID_FROM",
      "unit": "percent"
    },
    {
      "provider": "oecd",
      "enabled": false,
      "series_id": "OECD_CONFIGURED_SERIES",
      "field": "OECD_OFFICIAL_MACRO_SERIES",
      "url": "https://sdmx.oecd.org/public/rest/v1/data/DATAFLOW/KEY",
      "accept": "text/csv",
      "unit": "configured",
      "publication_lag_days": 45
    },
    {
      "provider": "imf",
      "enabled": true,
      "indicator": "NGDP_RPCH",
      "countries": [
        "USA",
        "CHN",
        "IND",
        "BRA"
      ],
      "field_prefix": "IMF_REAL_GDP_GROWTH",
      "unit": "percent",
      "publication_lag_days": 365,
      "fallback": {
        "provider": "dbnomics",
        "provider_code": "IMF",
        "dataset_code": "WEO:2025-04",
        "series_code_template": "{country}.{indicator}",
        "unit": "percent"
      }
    },
    {
      "provider": "world_bank",
      "enabled": true,
      "indicator": "NY.GDP.MKTP.KD.ZG",
      "countries": [
        "USA",
        "CHN",
        "IND",
        "BRA"
      ],
      "field_prefix": "WB_REAL_GDP_GROWTH",
      "unit": "percent",
